    },
    "policy": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "always_human_review": {
          "type": "boolean"
        },
        "review_loop_cap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
