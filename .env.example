# Colony dev env (ADR-004). Copy to .env and fill in.
# Real .env is gitignored.

NODE_ENV=development

# Postgres (Compose)
DATABASE_URL=postgres://colony:colony@localhost:5432/colony

# Temporal (Compose)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TLS=false
# Optional when connecting to a TLS endpoint through an internal address.
TEMPORAL_TLS_SERVER_NAME=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=colony-supervisor

# Agent runtime
AGENT_RUNTIME=fake
COLONY_CONFIG_PATH=config/colony.yaml
# OpenAI-compatible gateway key (for example a LiteLLM virtual key).
# Keep real values in SOPS/OpenBao, not in committed env files.
COLONY_OPENAI_COMPATIBLE_API_KEY=
# AES-256-GCM master key for OAuth token ciphertexts.
# Generate with: openssl rand -base64 32
# Local development may omit this and use a deterministic dev-only key.
COLONY_SECRET_ENCRYPTION_KEY=

# GitLab (home-lab — set these to the dev project/bot token)
GITLAB_BASE_URL=https://gitlab.home.shdr.ch
# Back-compat alias for the engine/developer bot token.
GITLAB_TOKEN=
GITLAB_REVIEWER_TOKEN=
# Role-keyed bot token map. Bootstrap emits these names in addition to aliases.
GITLAB_BOT_ENGINE_TOKEN=
GITLAB_BOT_REVIEWER_TOKEN=
GITLAB_BOT_ARCHITECT_TOKEN=
GITLAB_BOT_INTEGRATOR_TOKEN=
GITLAB_BOT_MEMORY_CONSOLIDATOR_TOKEN=
GITLAB_BOT_SUPERVISOR_TOKEN=
GITLAB_WEBHOOK_SECRET=
# Local default/dogfood project ID. Durable multi-repo scope targets live in the Task Graph.
GITLAB_DEV_PROJECT_ID=

# Service ports (defaults)
API_PORT=4000
WEBHOOK_DISPATCHER_PORT=4100
TOOL_GATEWAY_PORT=4200
WEB_PORT=3000

# The address home-lab GitLab should use to reach the local webhook dispatcher.
# Usually the laptop's LAN hostname/IP (e.g. shdrch-laptop.local or 10.0.0.42).
PUBLIC_HOST=localhost
