{
  "name": "colony",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --watch apps/colonyd/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:unit": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "3.8.3",
    "typescript": "^5.7.2"
  }
}
