{
  "name": "colony",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node -e \"if(require('fs').existsSync('.git'))require('child_process').execSync('git config core.hooksPath scripts/git-hooks',{stdio:'inherit'})\"",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "dev": "run-p -l -n --aggregate-output dev:*",
    "dev:api": "npm --workspace @colony/api run dev",
    "dev:worker": "npm --workspace @colony/worker run dev",
    "dev:webhook-dispatcher": "npm --workspace @colony/webhook-dispatcher run dev",
    "dev:tool-gateway": "npm --workspace @colony/tool-gateway run dev",
    "dev:web": "npm --workspace @colony/web run dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --workspace @colony/web run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run apps/api/src/index.test.ts apps/tool-gateway/src/app.test.ts apps/webhook-dispatcher/src/app.test.ts apps/worker/src/index.test.ts apps/worker/src/prompts/prompts.test.ts packages/agent-runtime/src/oauth-auth-storage.test.ts packages/config/test/colony-config.test.ts packages/db/test/secret-encryption.test.ts packages/domain/src/state-machines.test.ts packages/policy/test/evaluate.test.ts packages/provider/src/index.test.ts packages/schemas/src/schemas.test.ts",
    "test:temporal": "COLONY_TEMPORAL_TEST=1 vitest run packages/workflows/src/index.test.ts",
    "test:integration": "run-s test:integration:db test:integration:api test:integration:provider-gitlab-contract test:integration:worker",
    "test:integration:db": "npm --workspace @colony/db run test:integration",
    "test:integration:api": "npm --workspace @colony/api run test:integration",
    "test:integration:provider-gitlab-contract": "npm --workspace @colony/provider-gitlab run test:integration",
    "test:integration:worker": "npm --workspace @colony/worker run test:integration",
    "acceptance:phase0": "tsx scripts/phase0-acceptance.ts",
    "bots": "tsx scripts/bots.ts",
    "schemas:generate": "tsx scripts/schemas-generate.ts",
    "schemas:check": "tsx scripts/schemas-generate.ts && git diff --exit-code -- schemas/envelopes schemas/packets",
    "openapi:generate": "tsx scripts/openapi-generate.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- schemas/openapi",
    "db:migrate": "npm --workspace @colony/db run migrate:up",
    "db:migrate:down": "npm --workspace @colony/db run migrate:down",
    "acceptance:phase1": "tsx scripts/phase1-acceptance.ts",
    "acceptance:phase2": "tsx scripts/phase2-acceptance.ts",
    "acceptance:phase3": "tsx scripts/phase3-acceptance.ts",
    "bench:runners": "tsx scripts/bench-runners.ts",
    "test:bash": "echo test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.2"
  }
}
