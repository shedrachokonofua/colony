  "additionalProperties": false,
  "title": "PlanReviewPacket",
  "description": "Bounded context delivered to the Plan Reviewer run. Adds the developer_plan envelope and loop budget on top of the task packet.",
  "$defs": {
    "colony.envelope.developer_plan.v1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "done",
            "changes_requested",
            "approved",
            "blocked",
            "escalate"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requires_human": {
          "type": "boolean"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "issue",
                  "epic",
                  "mr",
                  "pr",
                  "commit",
                  "branch",
                  "pipeline",
                  "comment",
                  "release"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "uri"
            ],
            "additionalProperties": false,
            "title": "ArtifactRef",
            "description": "Pointer to a provider/repo/pipeline artifact, identified by Colony-stable id and provider URI. `hash` is required for any artifact with a meaningful content hash (commit, MR/PR head SHA, branch tip)."
          }
        },
        "policy_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string",
          "enum": [
            "request_review",
            "merge",
            "close",
            "wait_human",
            "return_to_author",
            "request_human_review",
            "propose_decomposition",
            "propose_discovered_work",
            "open_gate",
            "report_blocked",
            "escalate"
          ]
        },
        "freshness": {
          "type": "object",
          "properties": {
            "packet_hash": {
              "type": "string",
              "minLength": 1
            },
            "task_graph_version": {
              "type": "string",
              "minLength": 1
            },
            "provider_event_ts": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "commit_sha": {
              "type": "string",
              "minLength": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "memory_bundle_version": {
              "type": "string",
              "minLength": 1
            }
