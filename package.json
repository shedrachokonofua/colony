{
  "name": "colony",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --watch apps/colonyd/src/main.ts",
    "vendor:ui": "bun run scripts/vendor-ui.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/console/tsconfig.json",
    "test": "bun test apps packages scripts",
    "test:unit": "git ls-files 'apps/**/*.test.ts' 'packages/**/*.test.ts' 'scripts/*.test.ts' | grep -v '\\.integration\\.test\\.ts$' | xargs bun test",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.3.14",
    "happy-dom": "^16.0.0",
    "lit": "3.3.3",
    "prettier": "3.8.3",
    "typescript": "^5.7.2"
  }
}
