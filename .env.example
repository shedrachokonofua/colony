GITLAB_BASE_URL=https://gitlab.home.shdr.ch
GITLAB_TOKEN=                # admin/service PAT: api scope
GITLAB_WEBHOOK_SECRET=       # optional; empty disables webhook endpoint (polling still works)
COLONY_CONFIG_PATH=config/colony.yaml
COLONY_OPENAI_COMPATIBLE_API_KEY=   # consumed via config providers.*.auth.value env reference
COLONYD_PORT=4400
COLONYD_DB_PATH=data/colonyd.db
COLONYD_TICK_MS=15000
COLONYD_MAX_CONCURRENT=1
COLONYD_MAX_ATTEMPTS=3
COLONY_METRICS_PORT=9464     # optional
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=   # optional
