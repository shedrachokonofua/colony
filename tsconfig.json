{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@colony/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@colony/config": ["./packages/config/src/index.ts"],
      "@colony/core": ["./packages/core/src/index.ts"],
      "@colony/domain": ["./packages/domain/src/index.ts"],
      "@colony/observability": ["./packages/observability/src/index.ts"],
      "@colony/provider": ["./packages/provider/src/index.ts"],
      "@colony/provider-gitlab": ["./packages/provider-gitlab/src/index.ts"],
      "@colony/schemas": ["./packages/schemas/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "scripts/v2-acceptance.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
