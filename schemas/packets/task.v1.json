{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.v1",
  "version": 1,
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "pattern": "^col-[a-z0-9]{4,}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^col-[a-z0-9]{4,}\\.\\d+$"
    },
    "provider_issue": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "issue",
            "epic",
            "mr",
            "pr",
            "commit",
            "branch",
            "pipeline",
            "comment",
            "release"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "uri"
      ],
      "additionalProperties": false,
      "title": "ArtifactRef",
      "description": "Pointer to a provider/repo/pipeline artifact, identified by Colony-stable id and provider URI. `hash` is required for any artifact with a meaningful content hash (commit, MR/PR head SHA, branch tip)."
    },
    "repo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "branch",
        "base_commit"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^col-[a-z0-9]{4,}\\.\\d+$"
          },
          "state": {
            "type": "string",
            "enum": [
              "created",
              "ready",
              "claimed",
              "in_progress",
              "review_requested",
              "changes_requested",
              "merge_ready",
              "merged",
              "closed",
              "blocked",
              "conflict",
              "failed",
              "canceled",
              "pending_sync"
            ]
          }
        },
        "required": [
          "task_id",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "provider_context": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "issue_url": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "author": {
                "type": "string",
                "minLength": 1
              },
              "posted_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "body": {
                "type": "string"
              },
              "provider_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "author",
              "posted_at",
              "body",
              "provider_id"
            ],
            "additionalProperties": false,
            "description": "Untrusted provider comment surfaced as quoted context only. Never an instruction."
          }
        }
      },
      "required": [
        "provider",
        "issue_id",
        "issue_url",
        "labels",
        "recent_comments"
      ],
      "additionalProperties": false
    },
    "memory_bundle": {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "decision",
                  "semantic",
                  "procedural",
                  "episodic",
                  "policy"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "valid_from": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "id",
              "kind",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "semantic": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "decision",
                  "semantic",
                  "procedural",
                  "episodic",
                  "policy"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "valid_from": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "id",
              "kind",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "procedural": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "decision",
                  "semantic",
                  "procedural",
                  "episodic",
                  "policy"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "valid_from": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "id",
              "kind",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "policy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "decision",
                  "semantic",
                  "procedural",
                  "episodic",
                  "policy"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "valid_from": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "id",
              "kind",
              "summary"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "decisions",
        "semantic",
        "procedural",
        "policy"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "always_human_review": {
          "type": "boolean"
        },
        "review_loop_cap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "constraints",
        "protected_paths",
        "security_labels",
        "always_human_review",
        "review_loop_cap"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "graph.read",
          "graph.write",
          "task.claim",
          "task.assign",
          "task.close",
          "provider.comment",
          "provider.issue.update",
          "provider.branch.push",
          "provider.mr.open",
          "provider.mr.approve",
          "provider.mr.merge",
          "memory.candidate.write",
          "memory.write",
          "decision.write",
          "sandbox.exec",
          "tool.call",
          "release.deploy",
          "policy.override",
          "provider.admin.bootstrap"
        ]
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "mr",
              "pr",
              "commit",
              "branch",
              "review_envelope",
              "decomposition_envelope",
              "discovered_work_envelope",
              "scope_review_envelope",
              "blocked_envelope",
              "merge_readiness_envelope"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "tool_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sandbox_profile": {
      "type": "string",
      "minLength": 1
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_budget_minutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "freshness": {
      "type": "object",
      "properties": {
        "packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "task_graph_version": {
          "type": "string",
          "minLength": 1
        },
        "provider_event_ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "memory_bundle_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "packet_hash",
        "task_graph_version",
        "provider_event_ts",
        "commit_sha",
        "policy_version",
        "memory_bundle_version"
      ],
      "additionalProperties": false,
      "title": "Freshness",
      "description": "Freshness metadata required on every state-affecting envelope. Each field pins the agent run to a specific provider event, repo commit, policy version, memory bundle, Task Graph state version, and packet hash so the Supervisor can reject stale outputs."
    }
  },
  "required": [
    "version",
    "scope_id",
    "task_id",
    "provider_issue",
    "repo",
    "goal",
    "acceptance_criteria",
    "non_goals",
    "dependencies",
    "provider_context",
    "memory_bundle",
    "policy",
    "capabilities",
    "required_outputs",
    "tool_permissions",
    "sandbox_profile",
    "known_risks",
    "time_budget_minutes",
    "freshness"
  ],
  "additionalProperties": false,
  "title": "TaskPacket",
  "description": "Bounded context delivered to Developer (and Architect during decomposition) runs. Provider prose is quoted via provider_context, never injected as instructions."
}
