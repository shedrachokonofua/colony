{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scope_review.v1",
  "version": 1,
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "result": {
      "type": "string",
      "enum": [
        "done",
        "changes_requested",
        "approved",
        "blocked",
        "escalate"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human": {
      "type": "boolean"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "issue",
              "epic",
              "mr",
              "pr",
              "commit",
              "branch",
              "pipeline",
              "comment",
              "release"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id",
          "uri"
        ],
        "additionalProperties": false,
        "title": "ArtifactRef",
        "description": "Pointer to a provider/repo/pipeline artifact, identified by Colony-stable id and provider URI. `hash` is required for any artifact with a meaningful content hash (commit, MR/PR head SHA, branch tip)."
      }
    },
    "policy_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "enum": [
        "request_review",
        "merge",
        "close",
        "wait_human",
        "return_to_author",
        "request_human_review",
        "propose_decomposition",
        "propose_discovered_work",
        "open_gate",
        "report_blocked",
        "escalate"
      ]
    },
    "freshness": {
      "type": "object",
      "properties": {
        "packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "task_graph_version": {
          "type": "string",
          "minLength": 1
        },
        "provider_event_ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "memory_bundle_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "packet_hash",
        "task_graph_version",
        "provider_event_ts",
        "commit_sha",
        "policy_version",
        "memory_bundle_version"
      ],
      "additionalProperties": false,
      "title": "Freshness",
      "description": "Freshness metadata required on every state-affecting envelope. Each field pins the agent run to a specific provider event, repo commit, policy version, memory bundle, Task Graph state version, and packet hash so the Supervisor can reject stale outputs."
    },
    "rationale": {
      "type": "string"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^col-[a-z0-9]{4,}$"
    },
    "role_specific": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "minor",
                  "major",
                  "critical"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "acceptance_criterion_ref": {
                "type": "string"
              },
              "suggested_fix": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "severity",
              "evidence",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "conflict",
                  "pending_sync",
                  "blocked_task",
                  "open_proposal",
                  "missing_artifact"
                ]
              },
              "task_id": {
                "type": "string",
                "pattern": "^col-[a-z0-9]{4,}\\.\\d+$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "string"
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "approve_scope_close",
            "request_changes",
            "block_release",
            "escalate"
          ]
        }
      },
      "required": [
        "findings",
        "unresolved_items",
        "summary",
        "recommendation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "result",
    "confidence",
    "requires_human",
    "risk_level",
    "artifacts",
    "policy_flags",
    "next_action",
    "freshness",
    "rationale",
    "scope_id",
    "role_specific"
  ],
  "additionalProperties": false,
  "title": "ScopeReviewEnvelope",
  "description": "Reviewer output for the scope close gate. Aggregates findings and unresolved items across child tasks, and recommends approval / changes / block / escalate."
}
